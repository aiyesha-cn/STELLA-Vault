generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  pubkey    String   @unique
  username  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  points Int @default(0)

  referralCode String? @unique

  level2GateUnlockedAt   DateTime?
  level2GateUnlockMethod String?  // "points" | "payment"

  verificationLevel Int     @default(1)
  phone             String? @unique
  phoneVerified     Boolean @default(false)
  email             String?
  country           String?
  tosAccepted       Boolean @default(false)

  alternativeIdType      String?
  alternativeIdNumber    String?
  alternativeIdImageUrl  String?
  alternativeIdVerified  Boolean @default(false)

  endorsementCode      String?
  selfieVerified       Boolean @default(false)
  governmentIdVerified Boolean @default(false)
  kycPartner           String?

  verificationReviews VerificationReview[]

  vaults      Vault[]
  invitations Invitation[]
  logs        ActivityLog[]
  memberships VaultMember[]
  sentTransfers     PendingTransfer[] @relation("SentTransfers")
  receivedTransfers PendingTransfer[] @relation("ReceivedTransfers")

  ownedContacts Contact[] @relation("OwnedContacts")
  contactOf     Contact[] @relation("ContactOf")

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  trustScore                Int @default(0)
  savingsGoalsCompleted     Int @default(0)
  onTimeDeposits            Int @default(0)
  collaborativeVaultsCount  Int @default(0)
  disputesCount             Int @default(0)

  referralsMade Referral[] @relation("ReferralsMade")
  referredBy    Referral?  @relation("ReferredBy")

  createdGroups     GroupChat[]       @relation("CreatedGroups")
  groupMemberships  GroupChatMember[]
  sentGroupMessages GroupMessage[]    @relation("SentGroupMessages")
}

model Vault {
  id           String   @id @default(cuid())
  name         String
  description  String?
  goalType     String
  targetAmount Float
  ownerPubkey  String
  createdAt    DateTime @default(now())
  rotationOrder      Json?   
  contributionAmount Float?   
  currentRound       Int      @default(0)

  contractAddress String
  onChainVaultId   BigInt
  vaultType        String
  balance          Float     @default(0)
  status           String    @default("Active")
  lockUntil        DateTime?

  owner       User          @relation(fields: [ownerPubkey], references: [pubkey])
  invitations Invitation[]
  logs        ActivityLog[]
  members     VaultMember[]
  proposals VaultProposal []
  withdrawalRequests WithdrawalRequest[]

  @@unique([contractAddress, onChainVaultId])
}

model VaultProposal {
  id         String   @id @default(cuid())
  vaultId    String
  proposedBy String
  type       String   // "edit_goal" | "edit_lock" | "delete"
  changes    Json?    // { targetAmount? } for edit_goal | { lockUntil? } for edit_lock | null for delete
  status     String   @default("pending") // pending | approved | rejected | executed
  createdAt  DateTime @default(now())

  vault     Vault                   @relation(fields: [vaultId], references: [id])
  approvals VaultProposalApproval[]
}

model VaultProposalApproval {
  id         String   @id @default(cuid())
  proposalId String
  pubkey     String
  createdAt  DateTime @default(now())

  proposal VaultProposal @relation(fields: [proposalId], references: [id])

  @@unique([proposalId, pubkey])
}

model WithdrawalRequest {
  id              String   @id @default(cuid())
  vaultId         String
  onChainRequestId BigInt  // request_id returned by request_withdrawal on-chain
  requesterPubkey String
  recipientPubkey String
  amount          Float
  status          String   @default("pending") // pending | executed
  createdAt       DateTime @default(now())

  vault     Vault                 @relation(fields: [vaultId], references: [id])
  approvals WithdrawalApproval[]

  @@unique([vaultId, onChainRequestId])
}

model WithdrawalApproval {
  id        String   @id @default(cuid())
  requestId String
  pubkey    String
  createdAt DateTime @default(now())

  request WithdrawalRequest @relation(fields: [requestId], references: [id])

  @@unique([requestId, pubkey])
}

model VaultMember {
  id        String   @id @default(cuid())
  vaultId   String
  pubkey    String
  role      String   @default("Contributor")
  addedAt   DateTime @default(now())

  vault Vault @relation(fields: [vaultId], references: [id])
  user  User  @relation(fields: [pubkey], references: [pubkey])

  @@unique([vaultId, pubkey])
}

model Invitation {
  id            String   @id @default(cuid())
  vaultId       String
  invitedBy     String
  inviteePubkey String
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  vault   Vault @relation(fields: [vaultId], references: [id])
  inviter User  @relation(fields: [invitedBy], references: [pubkey])
}

model Notification {
  id        String   @id @default(cuid())
  pubkey    String
  message   String
  read      Boolean  @default(false)
  vaultId   String?
  variant   String   @default("info")
  meta      Json?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  vaultId   String?
  pubkey    String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  vault Vault? @relation(fields: [vaultId], references: [id])
  user  User   @relation(fields: [pubkey], references: [pubkey])
}

model Challenge {
  pubkey     String   @id
  challenge  String
  expiresAt  DateTime
}

model PendingTransfer {
  id                String   @id @default(cuid())
  senderPubkey      String
  recipientPubkey   String
  amount            Float
  senderAuthorized  Boolean  @default(false)
  receiverAuthorized Boolean @default(false)
  status            String   @default("awaiting_authorization")
  createdAt         DateTime @default(now())

  sender    User @relation("SentTransfers", fields: [senderPubkey], references: [pubkey])
  recipient User @relation("ReceivedTransfers", fields: [recipientPubkey], references: [pubkey])
}

model VerificationReview {
  id         String   @id @default(cuid())
  userId     String
  level      Int
  decision   String
  reason     String?
  reviewedBy String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

model Referral {
  id             String   @id @default(cuid())
  referrerPubkey String
  refereePubkey  String   @unique // one referral relationship per new user
  pointsAwarded  Int      @default(0)
  createdAt      DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerPubkey], references: [pubkey])
  referee  User @relation("ReferredBy", fields: [refereePubkey], references: [pubkey])
}

model Contact {
id            String   @id @default(cuid())
ownerPubkey   String
contactPubkey String
label         String?
createdAt     DateTime @default(now())

owner   User @relation("OwnedContacts", fields: [ownerPubkey], references: [pubkey])
contact User @relation("ContactOf", fields: [contactPubkey], references: [pubkey])

@@unique([ownerPubkey, contactPubkey])
}

model Message {
  id            String   @id @default(cuid())
  senderPubkey  String
  recipientPubkey String
  body          String
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  sender    User @relation("SentMessages", fields: [senderPubkey], references: [pubkey])
  recipient User @relation("ReceivedMessages", fields: [recipientPubkey], references: [pubkey])

  @@index([senderPubkey, recipientPubkey])
  @@index([recipientPubkey, senderPubkey])
}

model GroupChat {
  id        String   @id @default(cuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())

  creator  User              @relation("CreatedGroups", fields: [createdBy], references: [pubkey])
  members  GroupChatMember[]
  messages GroupMessage[]
}

model GroupChatMember {
  id       String   @id @default(cuid())
  groupId  String
  pubkey   String
  joinedAt DateTime @default(now())

  group GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [pubkey], references: [pubkey])

  @@unique([groupId, pubkey])
}

model GroupMessage {
  id           String   @id @default(cuid())
  groupId      String
  senderPubkey String
  body         String
  createdAt    DateTime @default(now())

  group  GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User      @relation("SentGroupMessages", fields: [senderPubkey], references: [pubkey])

  @@index([groupId, createdAt])
}